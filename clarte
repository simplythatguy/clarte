#!/bin/sh
# Clarte launcher. Fetches a pinned uv into .tools/ once, then runs tools/clarte.py with it.
set -eu
ROOT=$(cd "$(dirname "$0")" && pwd)
UV_VERSION=0.13.7
# SHA256 of each release asset, from its .sha256 file on github.com/astral-sh/uv/releases.
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)              T=aarch64-apple-darwin;      SUM=81b811b57e4624df7ed3aac148e0359100d9962f3d9dce00aec533dc2e086731 ;;
  Darwin-x86_64)             T=x86_64-apple-darwin;       SUM=20c47e4c1f630b8abaff8c291fa9b9aa300fef92c4fbff95adf198b55287cda7 ;;
  Linux-x86_64)              T=x86_64-unknown-linux-gnu;  SUM=c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83 ;;
  Linux-aarch64|Linux-arm64) T=aarch64-unknown-linux-gnu; SUM=71279f8d3c67241e807b9d8db872d1bf541579fb9f08b7d1eb1682196d1e57dc ;;
  *) echo "clarte: unsupported platform $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac
DIR="$ROOT/.tools/uv/$UV_VERSION"
UV="$DIR/uv"
if [ ! -x "$UV" ]; then
  echo "clarte: downloading uv $UV_VERSION for $T" >&2
  mkdir -p "$DIR"
  curl -fsSL "https://github.com/astral-sh/uv/releases/download/$UV_VERSION/uv-$T.tar.gz" -o "$DIR/uv.tar.gz"
  GOT=$( (sha256sum "$DIR/uv.tar.gz" 2>/dev/null || shasum -a 256 "$DIR/uv.tar.gz") | cut -d' ' -f1)
  if [ "$GOT" != "$SUM" ]; then rm -f "$DIR/uv.tar.gz"; echo "clarte: uv download failed its SHA256 check" >&2; exit 1; fi
  tar -xzf "$DIR/uv.tar.gz" -C "$DIR" --strip-components=1
  rm -f "$DIR/uv.tar.gz"
fi
export CLARTE_UV="$UV" UV_CACHE_DIR="$ROOT/.tools/uv-cache" UV_PYTHON_INSTALL_DIR="$ROOT/.tools/python"
exec "$UV" run --no-project --python 3.14 "$ROOT/tools/clarte.py" "$@"
