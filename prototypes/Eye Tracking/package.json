{
  "name": "still-local-gaze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host localhost --port 4318 --strictPort",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build": "npm run build:vendor && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "npm run build:vendor && vitest run tests",
    "check:privacy": "python3 scripts/check-adaptations.py && node scripts/check-webgazer-historical.mjs && python3 scripts/check-webeyetrack-adaptations.py && node scripts/check-privacy.mjs",
    "check:server": "node scripts/check-server.mjs",
    "preview": "vite preview --host localhost --port 4318 --strictPort",
    "check:runtime": "node scripts/runtime-browser-check.mjs",
    "check:model": "node scripts/check-model-training.mjs",
    "check:import": "node scripts/check-import.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.18",
    "@tensorflow-models/face-landmarks-detection": "1.0.6",
    "@tensorflow/tfjs": "4.22.0",
    "ml-matrix": "6.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "regression": "2.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
